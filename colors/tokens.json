{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "charcoal":     { "$value": "#121212", "$type": "color", "$description": "Primary dark background and body text." },
    "white":        { "$value": "#ffffff", "$type": "color", "$description": "Light surface, inverse text." },
    "brand-orange": { "$value": "#ff4f00", "$type": "color", "$description": "Primary accent. CTAs and highlights." },
    "orange-light": { "$value": "#fe6e00", "$type": "color", "$description": "Hover state and secondary accent." },
    "dark-grey":    { "$value": "#262626", "$type": "color", "$description": "Cards and secondary surfaces." },
    "mid-grey":     { "$value": "#333333", "$type": "color", "$description": "Secondary text." },
    "light-grey":   { "$value": "#e5e5e5", "$type": "color", "$description": "Borders and dividers." },
    "off-white":    { "$value": "#f5f5f5", "$type": "color", "$description": "Subtle backgrounds." },
    "black":        { "$value": "#000000", "$type": "color", "$description": "High contrast elements." }
  },
  "gradient": {
    "brand": {
      "$value": "linear-gradient(135deg, #ff4f00 0%, #fe6e00 100%)",
      "$type": "gradient",
      "$description": "Primary brand gradient used in the logo lockup."
    }
  }
}
